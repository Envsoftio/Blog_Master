// Host-local collection for a managed Prometheus/Loki backend. Credentials are
// read from /srv/seoblog/shared/observability.env by the systemd service.
prometheus.remote_write "managed" {
  endpoint {
    url = sys.env("SEOBLOG_PROMETHEUS_REMOTE_WRITE_URL")
    basic_auth {
      username = sys.env("SEOBLOG_PROMETHEUS_USERNAME")
      password = sys.env("SEOBLOG_PROMETHEUS_PASSWORD")
    }
  }
}

prometheus.scrape "api" {
  targets = [{ "__address__" = "127.0.0.1:8080" }]
  job_name = "seoblog-api"
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.managed.receiver]
}

prometheus.scrape "worker" {
  targets = [{ "__address__" = "127.0.0.1:9092" }]
  job_name = "seoblog-worker"
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.managed.receiver]
}

prometheus.scrape "litestream" {
  targets = [{ "__address__" = "127.0.0.1:9090" }]
  job_name = "seoblog-litestream"
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.managed.receiver]
}

prometheus.exporter.redis "local" {
  redis_addr = "redis://127.0.0.1:6379"
  redis_password = sys.env("SEOBLOG_REDIS_PASSWORD")
  redis_metrics_only = true
}

prometheus.scrape "redis" {
  targets = prometheus.exporter.redis.local.targets
  job_name = "seoblog-redis"
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.managed.receiver]
}

prometheus.exporter.unix "host" {
  enable_collectors = ["systemd"]
  systemd {
    enable_restarts = true
    start_time = true
    unit_include = "(nginx|redis-server|redis|seoblog-litestream|seoblog-backup-verify|seoblog-backup-monthly|seoblog-observability-export)\\.(service|timer)"
  }
  textfile {
    directory = "/srv/seoblog/shared/metrics"
  }
}

prometheus.scrape "host" {
  targets = prometheus.exporter.unix.host.targets
  job_name = "seoblog-host"
  scrape_interval = "15s"
  forward_to = [prometheus.remote_write.managed.receiver]
}

loki.write "managed" {
  endpoint {
    url = sys.env("SEOBLOG_LOKI_URL")
    basic_auth {
      username = sys.env("SEOBLOG_LOKI_USERNAME")
      password = sys.env("SEOBLOG_LOKI_PASSWORD")
    }
  }
}

local.file_match "pm2" {
  path_targets = [{
    "__path__" = sys.env("SEOBLOG_PM2_LOG_GLOB"),
    "service" = "seoblog-pm2",
  }]
}

loki.source.file "pm2" {
  targets = local.file_match.pm2.targets
  forward_to = [loki.write.managed.receiver]
}

loki.source.journal "litestream" {
  matches = "_SYSTEMD_UNIT=seoblog-litestream.service"
  labels = { "service" = "seoblog-litestream" }
  forward_to = [loki.write.managed.receiver]
}

loki.source.journal "backup" {
  matches = "_SYSTEMD_UNIT=seoblog-backup-verify.service"
  labels = { "service" = "seoblog-backup" }
  forward_to = [loki.write.managed.receiver]
}

loki.source.journal "nginx" {
  matches = "_SYSTEMD_UNIT=nginx.service"
  labels = { "service" = "nginx" }
  forward_to = [loki.write.managed.receiver]
}


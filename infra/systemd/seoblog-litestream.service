[Unit]
Description=SEO Blog continuous SQLite replication
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seoblog
Group=seoblog
EnvironmentFile=/srv/seoblog/shared/backup.env
ExecStart=/usr/local/bin/litestream replicate -config /srv/seoblog/backup/litestream.yml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/seoblog/shared

[Install]
WantedBy=multi-user.target


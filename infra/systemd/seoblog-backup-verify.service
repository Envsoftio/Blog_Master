[Unit]
Description=Create and verify an immutable SEO Blog SQLite recovery point
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=seoblog
Group=seoblog
EnvironmentFile=/srv/seoblog/shared/backup.env
ExecStart=/srv/seoblog/backup/create-recovery-point.sh daily
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/seoblog/shared

# Install as /srv/seoblog/shared/backup.env with mode 0600.
# This file is loaded only by the Litestream and backup systemd units.
SEOBLOG_DB_PATH=/srv/seoblog/shared/seoblog.db
SEOBLOG_LITESTREAM_CONFIG=/srv/seoblog/backup/litestream.yml
SEOBLOG_LITESTREAM_SOCKET=/srv/seoblog/shared/litestream.sock
SEOBLOG_BACKUP_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
SEOBLOG_BACKUP_REGION=eu-central-003
SEOBLOG_BACKUP_BUCKET=
SEOBLOG_BACKUP_LITESTREAM_PREFIX=continuous/production/seoblog
SEOBLOG_BACKUP_SNAPSHOT_PREFIX=snapshots/production
SEOBLOG_BACKUP_EVIDENCE_DIR=/srv/seoblog/shared/backup-evidence
SEOBLOG_BACKUP_DAILY_RETENTION_DAYS=31
# Required before enabling the monthly timer; use the approved legal/business policy.
SEOBLOG_BACKUP_MONTHLY_RETENTION_DAYS=
SEOBLOG_BACKUP_PRE_RELEASE_RETENTION_DAYS=31
SEOBLOG_BACKUP_OBJECT_LOCK_MODE=GOVERNANCE

# Continuous-replica write key: list/write only for the continuous prefix.
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Immutable-snapshot write key: write only for the snapshots prefix.
SEOBLOG_BACKUP_SNAPSHOT_KEY_ID=
SEOBLOG_BACKUP_SNAPSHOT_APPLICATION_KEY=

# Restore key: list/read only for both backup prefixes.
SEOBLOG_BACKUP_RESTORE_KEY_ID=
SEOBLOG_BACKUP_RESTORE_APPLICATION_KEY=
